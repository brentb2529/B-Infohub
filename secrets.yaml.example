# B-Infohub bridge secrets.  LOCAL TO THIS REPO -- gitignored.
#
# Deliberately NOT shared with the WaterFurnace project. The Wi-Fi credentials
# are the same network, but every device-identity secret below (API key, OTA
# password, AP password, web login) is unique to this bridge. Sharing an OTA
# password across projects means a mis-typed `esphome run` can flash the wrong
# device -- and these two speak different buses to different hardware.

# --- network: OPTIONAL ---
# Not needed to build or flash. The bridge onboards over USB, Bluetooth or its
# own "b-infohub Setup" Wi-Fi -- see docs/bring-up.md. These are only read if
# you uncomment the `networks:` block in packages/base.yaml to pre-seed a
# network and skip onboarding.
wifi_ssid: "CHANGEME"
wifi_password: "CHANGEME"

# --- MQTT: OPTIONAL ---
# Home Assistant reaches this bridge over the native API, so MQTT is an extra
# for Grafana and anything else on the network. The "Feature: MQTT" switch
# ships OFF; set a broker here, then turn it on.
mqtt_broker: "CHANGEME"
mqtt_username: "CHANGEME"
mqtt_password: "CHANGEME"

# --- device identity (generated {when}, unique to this bridge) ---
api_encryption_key: "{api}"
ota_password: "{ota}"
ap_password: "{ap}"
web_username: "admin"
web_password: "{web}"

# Generate fresh values:
#   python3 -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"  # api key
#   python3 -c "import secrets;print(secrets.token_urlsafe(24))"                                   # passwords
